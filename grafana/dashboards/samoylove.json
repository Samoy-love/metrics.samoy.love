    },
    {
      "type": "stat",
      "title": "Посетители за сутки",
      "description": "Успешные GET главной страницы за сутки за вычетом собственных проверок: blackbox (каждые 30 с) и агента статус-страницы (раз в минуту). Без вычета здесь стояло бы около 3500, из которых живых — десятки. Оценка грубая: остаток включает и чужих роботов, погрешность — несколько заходов.",
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min(sum(increase(samoylove_site_http_response_count_total{host=\"samoy.love\", path=\"/\", method=\"GET\", status=~\"2..|3..\"}[24h])) - sum(sum_over_time(probe_success{instance=\"https://samoy.love/\"}[24h])) - sum(changes(status_agent_run_timestamp_seconds[24h])), 0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
