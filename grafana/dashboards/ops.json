    {
      "type": "stat",
      "title": "CI",
      "description": "Светофор области: зелёный — ни один ключевой признак не сработал, жёлтый — есть предупреждение, красный — авария. Признаки: задания ждут раннера дольше порога (Linux 10 мин, лёгкие 5, Windows 15), молчит контроллер раннеров или сборщик очереди, в простаивающем раннере крутится сирота docker. Это короткая выжимка; полный список горящих тревог — ниже, подробности — на дашборде области (ссылка в углу панели).",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "samoylove-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(\n  label_replace(vector(0), \"signal\", \"ok\", \"\", \"\")\n  or label_replace((count((max(ci_job_queue_oldest_seconds{pool=~\"home-linux|set-heavy\"}) > 600)) > 0) * 0 + 1, \"signal\", \"очередь_linux\", \"\", \"\")\n  or label_replace((count((max(ci_job_queue_oldest_seconds{pool=~\"home-light|set-light\"}) > 300)) > 0) * 0 + 1, \"signal\", \"очередь_лёгкие\", \"\", \"\")\n  or label_replace((count((max(ci_job_queue_oldest_seconds{pool=\"home-windows\"}) > 900)) > 0) * 0 + 1, \"signal\", \"очередь_windows\", \"\", \"\")\n  or label_replace((count((time() - max(ci_autoscaler_timestamp_seconds) > 120)) > 0) * 0 + 1, \"signal\", \"контроллер\", \"\", \"\")\n  or label_replace((count((time() - max(ci_queue_collect_timestamp_seconds) > 600)) > 0) * 0 + 1, \"signal\", \"сборщик_очереди\", \"\", \"\")\n  or label_replace((count(((max by (name) (incus_memory_MemTotal_bytes{name=~\"ci-(runner|light).*\"} - incus_memory_MemAvailable_bytes{name=~\"ci-(runner|light).*\"})) * on(name) group_left() (max by (name) (label_replace(ci_autoscaler_slot{state=\"idle\"}, \"name\", \"$1\", \"slot\", \"(.*)\")) == 1) > 1.5 * 1024^3)) > 0) * 0 + 1, \"signal\", \"сирота_docker\", \"\", \"\")\n)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "в порядке",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "предупреждение",
                  "color": "#EAB839",
                  "index": 1
                },
                "2": {
                  "text": "авария",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
