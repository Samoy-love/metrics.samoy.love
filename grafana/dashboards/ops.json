    {
      "type": "stat",
      "title": "Пристрелка",
      "description": "Светофор области: зелёный — ни один ключевой признак не сработал, жёлтый — есть предупреждение, красный — авария. Признаки: сайт не открывается, служба или базы не отвечают, больше 5% пятисоток, демки исчезают у Valve, цепочку никто не ведёт (авария); нет связи с Valve, матч ждёт больше двух часов, машина рендера молчит, заказ клипа ждёт больше получаса, движок съёмки сломан (предупреждение). Это короткая выжимка; полный список горящих тревог — ниже, подробности — на дашборде области (ссылка в углу панели).",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "samoylove-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(\n  label_replace(vector(0), \"signal\", \"ok\", \"\", \"\")\n  or label_replace((count((probe_success{instance=\"https://cs.samoy.love/\"} == 0)) > 0) * 0 + 2, \"signal\", \"сайт\", \"\", \"\")\n  or label_replace((count((up{job=\"cs2-api\"} == 0)) > 0) * 0 + 2, \"signal\", \"служба\", \"\", \"\")\n  or label_replace((count((cs2_ready == 0)) > 0) * 0 + 2, \"signal\", \"базы\", \"\", \"\")\n  or label_replace((count((sum(rate(cs2_http_requests_total{code=~\"5..\"}[15m])) / clamp_min(sum(rate(cs2_http_requests_total[15m])), 0.0001) > 0.05)) > 0) * 0 + 2, \"signal\", \"пятисотки\", \"\", \"\")\n  or label_replace((count((cs2_chain_demos_expiring_soon > 0)) > 0) * 0 + 2, \"signal\", \"демки_исчезают\", \"\", \"\")\n  or label_replace((count((max(cs2_chain_leader{state=\"leading\"}) == 0)) > 0) * 0 + 2, \"signal\", \"цепочка\", \"\", \"\")\n  or label_replace((count((cs2_gc_ready == 0)) > 0) * 0 + 1, \"signal\", \"valve\", \"\", \"\")\n  or label_replace((count((max(cs2_chain_waiting_seconds) > 7200)) > 0) * 0 + 1, \"signal\", \"матч_ждёт\", \"\", \"\")\n  or label_replace((count((cs2_render_heartbeat_age_seconds > 600)) > 0) * 0 + 1, \"signal\", \"машина_рендера\", \"\", \"\")\n  or label_replace((count((max(cs2_render_waiting_seconds{class=~\"order|paid\"}) > 1800)) > 0) * 0 + 1, \"signal\", \"заказ_ждёт\", \"\", \"\")\n  or label_replace((count((cs2_render_engine_ok == 0)) > 0) * 0 + 1, \"signal\", \"движок\", \"\", \"\")\n)",
          "instant": true
        }
      ],
